# Built-in AI: the URL of your deployed server/ai-proxy Worker (see server/ai-proxy/README.md).
# With this set, Snap a meal and Coach work without users entering a key.
EXPO_PUBLIC_AI_PROXY_URL=
# Optional: must match the Worker's APP_TOKEN secret if you set one.
EXPO_PUBLIC_AI_APP_TOKEN=

# Friends & chat: the URL of your deployed server/social Worker (see server/social/README.md).
# Leave empty to use the built-in demo crew.
EXPO_PUBLIC_SOCIAL_URL=
